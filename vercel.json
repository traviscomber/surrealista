{
  "buildCommand": "next build",
  "functions": {
    "app/api/cron/nightly-property-scrapers/route.ts": { "maxDuration": 300 },
    "app/api/cron/retry-failed-property-scrapers/route.ts": { "maxDuration": 300 },
    "app/api/cron/inciti-public-market/route.ts": { "maxDuration": 300 },
    "app/api/cron/inciti-data-hub/route.ts": { "maxDuration": 300 },
    "app/api/cron/resolve-kmz-communes/route.ts": { "maxDuration": 300 },
    "app/api/cron/verify-kmz-sii/route.ts": { "maxDuration": 300 },
