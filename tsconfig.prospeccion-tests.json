{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp-prospeccion-tests",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "noEmitOnError": true
  },
  "include": [
    "lib/chile-locations.ts",
    "lib/prospeccion/normalization.ts",
    "lib/prospeccion/public-agri-intelligence.ts",
    "lib/prospeccion/owner-web-intelligence.ts",
    "lib/prospeccion/lead-state.ts",
    "lib/prospeccion/sentinel-satellite.ts",
    "lib/prospeccion/sentinel-parcel-analysis.ts",
    "lib/prospeccion/sentinel-memory.ts",
    "lib/prospeccion/sentinel-attention.ts",
    "lib/prospeccion/sentinel-spatial.ts",
    "lib/prospeccion/sentinel-targeting.ts",
    "lib/prospeccion/sentinel-targeting.ts",
    "tests/prospeccion-normalization.test.ts",
    "tests/prospeccion-public-agri-region.test.ts",
    "tests/prospeccion-owner-web.test.ts",
    "tests/prospeccion-lead-state.test.ts",
    "tests/prospeccion-sentinel-temporal.test.ts",
    "tests/prospeccion-sentinel-memory.test.ts",
    "tests/prospeccion-sentinel-attention.test.ts",
    "tests/prospeccion-sentinel-spatial.test.ts",
    "tests/prospeccion-sentinel-targeting.test.ts",
    "tests/prospeccion-sentinel-targeting.test.ts"
  ]
}
